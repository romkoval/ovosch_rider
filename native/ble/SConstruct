#!/usr/bin/env python
"""Сборка GDExtension ovosch_ble (REQ-DEV-01 крит. 6, REQ-NFR-06 крит. 2).

Использование (из native/ble):
    scons platform=linux   target=template_debug -j4
    scons platform=macos   target=template_debug
    scons platform=ios     target=template_release
godot-cpp ожидается в native/godot-cpp (см. README.md); другой путь —
`scons godot_cpp_path=/path/to/godot-cpp ...`.

Платформенный backend подключается через интерфейс BleBackend (src/ble_backend.h).
Пока реализован только null_backend (is_available() == false) — он собирается на любой
платформе, что и проверяет CI. CoreBluetooth-backend (macOS/iOS) — задача T-022: его
файлы кладутся в src/platform/apple/*.mm и включаются ниже с макросом
OVOSCH_BLE_HAS_PLATFORM_BACKEND.
"""
import os

# По умолчанию godot-cpp ищется в native/ble/godot-cpp (относительный путь — так SCons
# не раздувает командные строки абсолютными путями: при ../godot-cpp линковка
# libgodot-cpp.a падала с «Argument list too long»), затем в native/godot-cpp.
_default_godot_cpp = "godot-cpp" if os.path.isdir("godot-cpp") else os.path.join("..", "godot-cpp")
godot_cpp_path = ARGUMENTS.get("godot_cpp_path", _default_godot_cpp)
if not os.path.isdir(godot_cpp_path):
    print("godot-cpp не найден: %s. См. native/ble/README.md" % godot_cpp_path)
    Exit(1)

env = SConscript(os.path.join(godot_cpp_path, "SConstruct"))
env.Append(CPPPATH=["src/"])

sources = Glob("src/*.cpp")

platform = env["platform"]
has_platform_backend = False
if platform in ("macos", "ios"):
    apple_mm = Glob("src/platform/apple/*.mm")
    apple_cpp = Glob("src/platform/apple/*.cpp")
    if apple_mm or apple_cpp:
        has_platform_backend = True
        env.Append(CPPDEFINES=["OVOSCH_BLE_HAS_PLATFORM_BACKEND"])
        env.Append(LINKFLAGS=["-framework", "CoreBluetooth", "-framework", "Foundation"])
        if platform == "macos":
            # Mini-HUD overlay window (T-177): NSWindow level and Spaces behaviour.
            env.Append(LINKFLAGS=["-framework", "AppKit"])
        # ARC — только для Objective-C++ единиц трансляции; чистый C++ собирается без него.
        objc_env = env.Clone()
        objc_env.Append(CCFLAGS=["-fobjc-arc"])
        for f in apple_mm:
            sources.append(objc_env.SharedObject(f))
        sources += apple_cpp

if platform == "macos":
    # Фреймворк: бинарник + Resources/Info.plist. Без Info.plist codesign не распознаёт
    # бандл, и экспорт приложения с подписью (в т.ч. ad-hoc) падает. arch=universal даёт
    # один бинарник x86_64 + arm64 для экспорта binary_format/architecture="universal".
    fw_name = "libovosch_ble.{0}.{1}".format(platform, env["target"])
    fw_dir = "bin/{}.framework".format(fw_name)
    library = env.SharedLibrary("{}/{}".format(fw_dir, fw_name), source=sources)

    def _write_framework_plist(target, source, env):
        plist = (
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
            '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
            '<plist version="1.0">\n<dict>\n'
            "\t<key>CFBundleExecutable</key>\n\t<string>{name}</string>\n"
            "\t<key>CFBundleIdentifier</key>\n\t<string>org.ovoschrider.{ident}</string>\n"
            "\t<key>CFBundleInfoDictionaryVersion</key>\n\t<string>6.0</string>\n"
            "\t<key>CFBundleName</key>\n\t<string>{name}</string>\n"
            "\t<key>CFBundlePackageType</key>\n\t<string>FMWK</string>\n"
            "\t<key>CFBundleShortVersionString</key>\n\t<string>1.0.0</string>\n"
            "\t<key>CFBundleSupportedPlatforms</key>\n\t<array>\n\t\t<string>MacOSX</string>\n\t</array>\n"
            "\t<key>CFBundleVersion</key>\n\t<string>1.0.0</string>\n"
            "\t<key>LSMinimumSystemVersion</key>\n\t<string>11.0</string>\n"
            "</dict>\n</plist>\n"
        ).format(name=fw_name, ident=fw_name.replace("_", "-").replace(".", "-"))
        with open(str(target[0]), "w") as out:
            out.write(plist)

    plist_node = env.Command("{}/Resources/Info.plist".format(fw_dir), [], _write_framework_plist)
    env.Depends(library, plist_node)
    library = [library, plist_node]
elif platform == "ios":
    library = env.StaticLibrary(
        "bin/libovosch_ble.{}.{}.a".format(platform, env["target"]),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "bin/libovosch_ble{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
