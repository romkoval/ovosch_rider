<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>ovosch-rider tests</author>
    <name>VO2 Intervals</name>
    <description>3 x 4 мин / 2 мин с подсказками.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.70" CadenceLow="85" CadenceHigh="95">
            <textevent timeoffset="10" message="Разогреваемся"/>
            <textevent timeoffset="590" message="Скоро первый интервал" duration="10"/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="240" OffDuration="120" OnPower="1.05" OffPower="0.50" Cadence="95" CadenceResting="80">
            <textevent timeoffset="0" message="Жми!"/>
            <textevent timeoffset="240" message="Отдых"/>
        </IntervalsT>
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.95" pace="1"/>
        <SteadyState Duration="60" Power="0.5" OverUnder="1"/>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
    </workout>
</workout_file>
